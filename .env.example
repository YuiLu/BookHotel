# 真实信息只填在本地 .env；不把卡号写进 config.json。
# 仅监控 + 微信推送只需填写这个 token，其余旅客/支付信息可以不填。
PUSHPLUS_TOKEN=CHANGE_ME
GUEST_LAST_NAME=CHANGE_ME
GUEST_FIRST_NAME=CHANGE_ME
# 官网要求ひらがな（平假名），请填本人姓名的正确读音。
GUEST_LAST_NAME_KANA=CHANGE_ME
GUEST_FIRST_NAME_KANA=CHANGE_ME
GUEST_EMAIL=CHANGE_ME
# 海外手机号可写 138-1234-5678；中国 11 位手机号也支持自动拆分。
GUEST_PHONE=CHANGE_ME
CARD_NUMBER=CHANGE_ME
CARD_HOLDER=CHANGE_ME
CARD_EXP_MONTH=CHANGE_ME
CARD_EXP_YEAR=CHANGE_ME
CARD_CVC=CHANGE_ME
